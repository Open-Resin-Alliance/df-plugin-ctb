    {
      "id": "first-layer-settings",
      "title": "First Layer Movement",
      "tabId": "simple",
      "sectionId": "burn-in",
      "order": 15,
      "description": "How the plate moves before layer 1. The two Whale3 modes lift 2.5 mm and come back down at 20 mm/min, and move every layer down with layer 1. At your own responsibility: the plate is driven to or below its home position."
    },
    {
      "id": "wait-times-settings",
      "title": "Wait Times",
      "tabId": "simple",
      "sectionId": "wait-times",
      "order": 35,
      "description": "Every wait value. Bottom values apply to the first Bottom Wait Layers layers; the rest use the normal values. Switch on the schedule below for separate layer 1 / layer 2 waits and a gradual step down to the normal wait before cure."
    }
  ],
